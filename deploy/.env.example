# ============================================================
# JAQUEMATE — Variables de entorno
# Copiar este archivo a .env y rellenar los valores marcados.
# NUNCA commitear el .env real al repo.
# ============================================================

# ---------- DOMINIO ----------
# Dominio raíz (apex) sobre el que Twenty construye los subdominios de cada workspace.
# Twenty con IS_MULTIWORKSPACE_ENABLED=true prefija DEFAULT_SUBDOMAIN para el portal de login
# y el slug de cada workspace para los tenants. NO incluir "app." aquí o queda app.app.<dom>.
SERVER_URL=https://jaquemate.jaqueting.com

# n8n vive en otro subdominio
N8N_HOST=engine.jaquemate.jaqueting.com
N8N_WEBHOOK_URL=https://engine.jaquemate.jaqueting.com/

# ---------- POSTGRES ----------
PG_DATABASE_USER=postgres
# Generar: openssl rand -base64 32 | tr -d "/=+" | cut -c1-25
PG_DATABASE_PASSWORD=REEMPLAZAR_password_postgres_25_chars_min
PG_DATABASE_NAME=default

# ---------- TWENTY ----------
# Generar: openssl rand -base64 32
APP_SECRET=REEMPLAZAR_app_secret_32_chars_random
# Pinear versión específica si querés estabilidad. "latest" es OK para arranque.
TWENTY_TAG=latest
# Storage: local para hoy, S3 cuando crezca
STORAGE_TYPE=local

# ---------- N8N ----------
N8N_BASIC_AUTH_USER=admin
# Password fuerte para la consola de admin de n8n
N8N_BASIC_AUTH_PASSWORD=REEMPLAZAR_password_n8n_24_chars
# Generar: openssl rand -base64 32
N8N_ENCRYPTION_KEY=REEMPLAZAR_encryption_key_32_chars_random

# ---------- TIMEZONE ----------
TIMEZONE=America/Los_Angeles

# ---------- EMAIL (opcional, descomentar en docker-compose.yml cuando esté listo) ----------
# EMAIL_FROM_ADDRESS=jaquemate@jaqueting.com
# EMAIL_FROM_NAME=Jaque Mate Jaqueting
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
